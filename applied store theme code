body.sd-store:not(#_) #sd-portal .sd-brand-header{order:-1}
body.sd-store:not(#_) #sd-portal .sd-partners-footer{order:99;margin-top:auto}
body.sd-store>*:not(#sd-portal){flex:0 0 auto}

